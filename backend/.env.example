# VeloTrack backend — copy to backend/.env on the VPS.
# Put all private values in the server's secret store or this ignored local .env; never commit this file.

HOST=0.0.0.0
PORT=3000
VELOTRACK_API_DOMAIN=
CORS_ALLOWED_ORIGINS=https://velotrack-web.vercel.app

# Verified cloud Supabase project (do NOT deploy a second self-hosted Supabase instance).
SUPABASE_URL=https://ixazqslcmqjmndhiyhux.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_8d2LOE7xILs6dxP7K2TKaw_9hCc8BP_
# Optional legacy public key; leave blank when using the publishable key above.
SUPABASE_ANON_KEY=
# Supply one modern sb_secret_ key OR legacy service-role key through the VPS secret store.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated VeloTrack application JWT signing secret (random, at least 32 bytes); do not reuse a Supabase JWT signing secret.
SUPABASE_JWT_SECRET=
# Copy the full PostgreSQL URI from Supabase Dashboard -> Connect. Host is db.ixazqslcmqjmndhiyhux.supabase.co.
SUPABASE_DB_URL=
SUPABASE_DB_SSL=true

# One-time initial VeloTrack administrator bootstrap. Do not commit the temporary password.
VELOTRACK_INITIAL_ADMIN_EMAIL=mahmoud.hindam9@gmail.com
VELOTRACK_INITIAL_ADMIN_USERNAME=admin
VELOTRACK_INITIAL_ADMIN_PASSWORD=
VELOTRACK_INITIAL_ADMIN_PHONE=

# Private Traccar connection. This hostname works because both containers join velotrack-shared.
BACKEND_DEPLOYMENT_MODE=vps_local
TRACCAR_PRIVATE_TUNNEL_ENABLED=false
TRACCAR_BASE_URL=http://traccar:8082
TRACCAR_ADMIN_EMAIL=
TRACCAR_ADMIN_PASSWORD=

# Optional private bidirectional GSM modem gateway.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_WEBHOOK_SECRET=

# Optional public HTTPS origin used only for short-lived location-share links.
TRACCAR_PUBLIC_URL=
