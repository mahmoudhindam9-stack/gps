# Copy to .env on the backend server and supply real production secrets via the Secrets panel.
# Never commit .env or ship secret / service-role / admin keys inside the Android APK or web bundle.

HOST=0.0.0.0
PORT=3000
VELOTRACK_API_DOMAIN=
CORS_ALLOWED_ORIGINS=https://velotrack-web.vercel.app

# Verified Supabase Project: supabase-cerulean-diamond (wtbyarkiizmncjnuomti, us-east-1)
SUPABASE_URL=https://wtbyarkiizmncjnuomti.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind0YnlhcmtpaXptbmNqbnVvbXRpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcxNDE2MTgsImV4cCI6MjEwMjcxNzYxOH0.DnXKFsqJpgjDL0zX6nYyywXEHA6g4Ob-ZejzqKuzXjI
SUPABASE_PUBLISHABLE_KEY=sb_publishable__hzTBUR9FagjPY4JO4E4Yw_iVcdNCGP
# Supply SUPABASE_SECRET_KEY (sb_secret_...) via Secure Secrets (SUPABASE_SERVICE_ROLE_KEY supported as fallback)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Hostname: db.wtbyarkiizmncjnuomti.supabase.co — copy full URI from Supabase Dashboard -> Connect
SUPABASE_DB_URL=
SUPABASE_DB_SSL=true

# One-Time Initial Administrator Bootstrap Secrets
# Bootstraps username `admin` linked to `VELOTRACK_INITIAL_ADMIN_EMAIL` in `auth.users`
# with temporary password `VELOTRACK_INITIAL_ADMIN_PASSWORD` and forces password change on 1st login.
VELOTRACK_INITIAL_ADMIN_EMAIL=
VELOTRACK_INITIAL_ADMIN_USERNAME=admin
VELOTRACK_INITIAL_ADMIN_PASSWORD=
VELOTRACK_INITIAL_ADMIN_PHONE=

# Private Traccar Server Connection (Port 8082 must remain private)
# Use vps_local when running on the same VPS as Traccar, or external with a private WireGuard/SSH tunnel.
BACKEND_DEPLOYMENT_MODE=vps_local
TRACCAR_PRIVATE_TUNNEL_ENABLED=false
TRACCAR_BASE_URL=http://traccar:8082
TRACCAR_ADMIN_EMAIL=
TRACCAR_ADMIN_PASSWORD=

# Private Bidirectional GSM Modem Gateway Configuration (Optional)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_WEBHOOK_SECRET=

# Optional public HTTPS origin used only to build short-lived Traccar location-share links.
# This must be the public Traccar web origin, not the private TRACCAR_BASE_URL.
TRACCAR_PUBLIC_URL=
