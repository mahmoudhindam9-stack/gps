# Copy to .env and supply real production secrets before starting the VeloTrack backend.
# Never commit .env or ship these values inside the Android APK.

PORT=3000
VELOTRACK_DB_URL=postgresql://velotrack:replace_with_strong_db_password@127.0.0.1:5433/velotrack
VELOTRACK_DB_PASSWORD=replace_with_strong_db_password

# 32+ byte random secret for signing and verifying VeloTrack session JWTs
VELOTRACK_JWT_SECRET=replace_with_openssl_rand_hex_32

# Loopback Traccar Server connection (from deployment/traccar/compose.yaml)
TRACCAR_BASE_URL=http://127.0.0.1:8082
TRACCAR_ADMIN_EMAIL=
TRACCAR_ADMIN_PASSWORD=

# Private Bidirectional GSM Modem Gateway configuration
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_WEBHOOK_SECRET=
