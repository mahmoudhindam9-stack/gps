# Copy to .env on the backend server and supply real production secrets.
# Never commit .env or ship service-role / admin secrets inside the Android APK.

HOST=0.0.0.0
PORT=3000
VELOTRACK_API_DOMAIN=
CORS_ALLOWED_ORIGINS=https://dashboard.velotrack.example.com,http://localhost:5173

# Approved Supabase Auth & PostgreSQL Configuration (Server-Side Only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=
SUPABASE_DB_SSL=false

# One-Time Initial Administrator Bootstrap Secrets
# Bootstraps username `admin` linked to `VELOTRACK_INITIAL_ADMIN_EMAIL` in `auth.users`
# with temporary password `VELOTRACK_INITIAL_ADMIN_PASSWORD` and forces password change on 1st login.
VELOTRACK_INITIAL_ADMIN_EMAIL=
VELOTRACK_INITIAL_ADMIN_USERNAME=admin
VELOTRACK_INITIAL_ADMIN_PASSWORD=
VELOTRACK_INITIAL_ADMIN_PHONE=

# Private Traccar Server Connection (Port 8082 must remain private)
# Use vps_local when running on the same VPS as Traccar, or external with a private WireGuard/SSH tunnel.
BACKEND_DEPLOYMENT_MODE=vps_local
TRACCAR_PRIVATE_TUNNEL_ENABLED=false
TRACCAR_BASE_URL=http://traccar:8082
TRACCAR_ADMIN_EMAIL=
TRACCAR_ADMIN_PASSWORD=

# Private Bidirectional GSM Modem Gateway Configuration
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_WEBHOOK_SECRET=


# Optional public HTTPS origin used only to build short-lived Traccar location-share links.
# This must be the public Traccar web origin, not the private TRACCAR_BASE_URL.
TRACCAR_PUBLIC_URL=
