# Copy this file to .env and set a long, unique database password.
# Never commit the real .env file or share credentials in chat.
TRACCAR_DB_PASSWORD=replace_with_a_unique_long_random_password

# Keep the server version pinned. Update only after backup and protocol regression testing.
TRACCAR_IMAGE=traccar/traccar:6.17.0

# Database image used only for Traccar telemetry/history, separate from Supabase business data.
TRACCAR_DB_IMAGE=timescale/timescaledb:latest-pg17

# Public IPv4 bind for GPS tracker listener ports. Restrict at the OS and cloud firewalls.
GPS_INGRESS_BIND_ADDRESS=0.0.0.0
