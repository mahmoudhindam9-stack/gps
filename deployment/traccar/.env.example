# Copy this file to .env and replace the placeholder before starting Compose.
# Never commit the real .env file or share these credentials in chat.
TRACCAR_DB_PASSWORD=replace_with_a_unique_long_random_password

# Keep the Traccar version explicit. Upgrade only after backup and compatibility testing.
TRACCAR_IMAGE=traccar/traccar:6.17.0

# Official Traccar TimescaleDB/PostgreSQL deployment image.
# Pin an exact version or image digest before production rollout.
TRACCAR_DB_IMAGE=timescale/timescaledb:latest-pg17

# Public bind address for tracker protocol packets. Restrict TCP 5023 in the VPS firewall.
GT06_BIND_ADDRESS=0.0.0.0
