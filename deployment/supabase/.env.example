# Copy to deployment/supabase/.env on the VPS and populate with your real self-hosted Supabase secrets.
# Never commit deployment/supabase/.env or expose POSTGRES_PASSWORD / SERVICE_ROLE_KEY publicly.

POSTGRES_DB=postgres
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600

# Standard Supabase HS256 JWT keys signed with JWT_SECRET above
ANON_KEY=
SERVICE_ROLE_KEY=

# Internal URL over velotrack-shared private Docker network
API_EXTERNAL_URL=http://supabase-kong:8000
SITE_URL=http://localhost:3000
